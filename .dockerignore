# Generated assets (gitignored). They are absent from a clean checkout but
# present after `npm install` locally, which would otherwise push ~250MB of
# build context into the image and make its size depend on the machine that
# built it. The image recreates what it needs during postbuild, and nginx
# serves the LibreOffice payloads straight from .bin.gz via gzip_static.
public/libreoffice-wasm/soffice.wasm.bin
public/libreoffice-wasm/soffice.data.bin
public/pdfjs-viewer/pdf.js
public/pdfjs-viewer/pdf.sandbox.js
public/pdfjs-viewer/pdf.worker.js
public/pdfjs-viewer/pdf_viewer.js
public/pdfjs-viewer/viewer.js
public/workers/pdf.worker.min.js
